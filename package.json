{
  "name": "@soraforge/forgecheck",
  "version": "0.0.0",
  "private": true,
  "description": "Stellar application compatibility tooling (CLI foundation; scanner not implemented)",
  "type": "module",
  "bin": {
    "forgecheck": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "default": "./dist/application.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check:repo": "node scripts/check-repository.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "22.15.29"
  },
  "license": "Apache-2.0"
}
